#!/bin/bash
set -eux


until ip -4 -o addr show | grep -q " ${localip}/"; do sleep 2; done
PUBLIC_IPV4=$(curl -sf https://api.ipify.org)

curl -sfL --retry 5 --retry-all-errors https://get.k3s.io | \
  K3S_TOKEN="${token}" \
  INSTALL_K3S_EXEC="server \
    --node-ip ${localip} \
    --advertise-address ${localip} \
    --node-external-ip $PUBLIC_IPV4 \
    --tls-san $PUBLIC_IPV4 \
    --secrets-encryption" sh -