apiVersion: v1
kind: ConfigMap
metadata:
  name: netbird-server-config
data:
  config.yaml: |
    server:
      listenAddress: ":80"
      exposedAddress: "https://netbird.atayi.net:443"
      stunPorts:
        - 3478
      metricsPort: 9090
      healthcheckAddress: ":9000"
      logLevel: "info"
      logFile: "console"

      authSecret: "x"
      dataDir: "/var/lib/netbird"

      auth:
        issuer: "https://netbird.atayi.net/oauth2"
        signKeyRefreshEnabled: true
        sessionCookieEncryptionKey: "x"
        dashboardRedirectURIs:
          - "https://netbird.atayi.net/nb-auth"
          - "https://netbird.atayi.net/nb-silent-auth"
        cliRedirectURIs:
          - "http://localhost:53000/"

      reverseProxy:
        trustedHTTPProxies:
          - "172.30.0.10/32"

      store:
        engine: "sqlite"
        encryptionKey: "x"
