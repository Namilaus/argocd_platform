apiVersion: argocd-image-updater.argoproj.io/v1alpha1
kind: ImageUpdater
metadata:
  name: netbird-update-strategy
  namespace: argocd
spec:
  writeBackConfig:
    method: "git:secret:argocd/github-creds"
    gitConfig:
      repository: "https://github.com/Namilaus/argocd_platform"
      branch: "main"
  applicationRefs:
    - namePattern: "agents"
      images:
        - alias: "hermes"
          imageName: "nousresearch/hermes-agent"
          commonUpdateSettings:
            updateStrategy: "semver"
